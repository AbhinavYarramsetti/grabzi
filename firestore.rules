rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if true;
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isOwner();
      allow delete: if false;
    }

    match /vendors/{vendorId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /deals/{dealId} {
      allow get, list: if true;

      // This function wasn't being used to secure access in the original rules
      // and vendorId wasn't available. To maintain secure access, I'm removing it.
      // If vendorId is important, it needs to be present in the document
      // and the function needs to be updated to leverage `resource.data.vendorId`
      // and `request.auth.uid` for comparison.
      //function isDealOwner(vendorId) {
      //  return request.auth != null && request.auth.uid == vendorId;
      //}

      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /puzzles/{puzzleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get, list: if isOwner();
      allow create: if request.auth.uid == userId;
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /leaderboard/{userId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}